@page "/products"
@using Web.Blazor.Models
@using Web.Blazor.Services
@inject ICatalogService CatalogService
@inject ILogger<Products> Logger

<PageTitle>Produtos</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Catálogo de Produtos</h1>

            @if (isLoading)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="mt-3">Carregando produtos...</p>
                </div>
            }
            else if (errorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Erro ao carregar produtos</h4>
                    <p>@errorMessage</p>
                    <hr>
                    <button class="btn btn-danger" @onclick="LoadProducts">
                        <i class="bi bi-arrow-clockwise"></i> Tentar novamente
                    </button>
                </div>
            }
            else if (products == null || !products.Any())
            {
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">Nenhum produto encontrado</h4>
                    <p>Não há produtos cadastrados no catálogo no momento.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Nome</th>
                                <th>Descrição</th>
                                <th class="text-end">Preço</th>
                                <th class="text-center">Estoque</th>
                                <th class="text-center">Criado em</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in products)
                            {
                                <tr>
                                    <td>
                                        <strong>@product.Name</strong>
                                    </td>
                                    <td>@product.Description</td>
                                    <td class="text-end">
                                        <span class="badge bg-success">
                                            @product.Price.ToString("C2")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (product.Stock > 0)
                                        {
                                            <span class="badge bg-primary">@product.Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Sem estoque</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <small class="text-muted">
                                            @product.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <p class="text-muted">
                        Total de produtos: <strong>@products.Count()</strong>
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IEnumerable<ProductDto>? products;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            Logger.LogInformation("Loading products from Catalog API");
            products = await CatalogService.GetAllProductsAsync();

            if (products == null)
            {
                errorMessage = "Não foi possível conectar ao serviço de catálogo. Verifique se a API está rodando.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading products");
            errorMessage = $"Erro inesperado: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
