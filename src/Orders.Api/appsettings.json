{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Orders.Api.Services.OutboxProcessor": "Information"
    }
  },
  "AllowedHosts": "*",
  "OutboxProcessor": {
    "IntervalSeconds": 5,
    "BatchSize": 10
  },
  "RabbitMQ": {
    "ExchangeName": "orders-events",
    "ExchangeType": "topic"
  }
}
